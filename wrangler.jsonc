{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "ip-city-rest-map",
    "compatibility_date": "2026-05-31",
    "assets": {
        "directory": "./public/src"
    },
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true,
            "invocation_logs": true
        },
        "traces": {
            "enabled": false,
            "persist": true,
            "head_sampling_rate": 1
        }
    },
    "preview-urls": true,
    //defining build settings
    "build": {
        "command": "npm run",
        "cwd": ".",
        "watch_dir": "public/src"
    }
}